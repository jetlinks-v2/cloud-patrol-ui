{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "vue": ["../../node_modules/vue"],
      "vue/*": ["../../node_modules/vue/*"],
      "@jetlinks-web-core/*": ["../../jetlinks-web-core/src/*"],
      "@/*": ["../../jetlinks-web-core/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.vue",
    "../../jetlinks-web-core/src/auto-imports.d.ts",
    "../../jetlinks-web-core/src/env.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
