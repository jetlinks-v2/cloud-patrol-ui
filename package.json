{
  "name": "cloud-patrol-ui",
  "id": "cloud-patrol",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "jsencrypt": "3.3.2",
    "jsqr": "1.4.0"
  },
  "scripts": {
    "build": "pnpm --filter jetlinks-web-core build -- -- --module-name cloud-patrol-ui",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "typecheck:workspace": "vue-tsc --noEmit -p tsconfig.workspace.json",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "typecheck:mobile": "vue-tsc --noEmit -p tsconfig.mobile.json",
    "dev": "pnpm --filter jetlinks-web-core dev -- -- --module-name cloud-patrol-ui,property-base-ui,authentication-manager-ui",
    "build:with-base": "pnpm --filter jetlinks-web-core build -- -- --module-name cloud-patrol-ui,property-base-ui"
  },
  "peerDependencies": {
    "vue": "^3.3.4",
    "vue-i18n": "^9.14.3",
    "ant-design-vue": "^4.2.6",
    "@jetlinks-web/core": "^2.3.7",
    "@jetlinks-web/utils": "^1.3.3",
    "dayjs": "^1.11.13",
    "@vueuse/core": "^10.11.1"
  },
  "devDependencies": {
    "vite": "^7.1.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.8.2",
    "vue-tsc": "^3.0.6"
  }
}
